# 홈 대시보드 폴링 주기(초)
HOME_STREAM_INTERVAL_SEC=1.0

# 실시간 마크 스트림 vs 1h 차트 폴링
CHART_POLL_SEC=90

# 청산 맵 (backtest liq_cache_builder 와 동일: window=400, min_bars=50)
# Redis·메모리에는 window 의 2배(기본 800봉)만 유지
LIQ_WINDOW=400
LIQ_RETAIN_BARS=800
LIQ_MIN_BARS=50
LIQ_REFRESH_SEC=120
LIQ_SYMBOLS=BTCUSDT,ETHUSDT
# 캐시가 비어 있을 때 첫 요청에서 REST로 채움 (false면 캐시만, cold 시 503)
LIQ_ON_DEMAND_FETCH=true

# 알림 채널 (AlertDispatcher — 설정된 채널에 동시 전송)
# Telegram
# TELEGRAM_BOT_TOKEN=...
# TELEGRAM_CHAT_ID=...
# Discord Webhook
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/{id}/{token}
# Strategy-specific Discord Webhook (takes precedence over DISCORD_WEBHOOK_URL)
# ETH_CVD_EXPLOSION_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/{id}/{token}

# Redis (비우면 메모리 캐시만 사용)
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=forwardtest:v1
REDIS_TTL_SEC=7200

# Binance Futures 마크 WS (선택)
# BINANCE_WS_MIN_RECONNECT_SEC=3.0

# ── 접근 제어 (이력 공개용 기간제 패스) ──────────────────────────────────────
# AUTH_ENABLED 는 필수. 값이 없거나 true/false 가 아니면 앱이 기동에 실패한다.
AUTH_ENABLED=true
# admin 로그인 비밀번호 (8자 이상). 만료 없음 — AUTH_ADMIN_TTL_DAYS 동안 세션 유지
ADMIN_PASSWORD=change-me-long-and-random
# 쿠키 서명 + 패스코드 해시용 시크릿 (32자 이상)
#   생성: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=change-me-32-chars-minimum-random-secret
# 게스트 패스 기본 유효시간 (시간). 발급 화면에서 건별로 덮어쓸 수 있음
AUTH_GUEST_TTL_HOURS=24
# admin 세션 쿠키 유효기간 (일)
AUTH_ADMIN_TTL_DAYS=30
